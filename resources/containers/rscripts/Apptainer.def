Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%post
    # Create the environment
    micromamba create -y -p /opt/conda/envs/rscripts -c bioconda -c conda-forge \
        r-base=4.4.3 \
        r-dplyr=1.1.4 \
        r-readr=2.1.5 \
        r-purrr=1.0.2 \
        r-tidyr=1.3.1
    micromamba clean --all --yes

%environment
    export PATH="/opt/conda/envs/rscripts/bin:$PATH"

%labels
    Maintainer andrei.guliaev@scilifelab.uu.se
    Version 4.4.3
    Env rscripts
